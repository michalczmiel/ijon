{
  "name": "sandbox-lambda",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit -w",
    "test": "vitest run",
    "cdk": "cdk",
    "fetch:ijon": "bash scripts/fetch-ijon.sh",
    "db:create": "bash scripts/dynamodb-create.sh",
    "db:scan": "bash scripts/dynamodb-scan.sh",
    "db:query": "bash scripts/dynamodb-query.sh",
    "local:invoke": "pnpm fetch:ijon && cdk synth --quiet && sam local invoke -t ./cdk.out/SandboxLambdaStack.template.json --env-vars env.local.json --docker-network ijon --event event.local.json AgentRunner"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1129.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.5.0"
  }
}
